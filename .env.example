# Safe template for sharing/uploading this project
# Copy to .env.local and fill in values locally.

CONTEXT_PROVIDER=openai
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=20000

TRANSCRIBE_BACKEND=whispercpp
WHISPERCPP_MODEL=./vendor/whisper.cpp/models/ggml-tiny.bin
WHISPERCPP_CLI=./vendor/whisper.cpp/build/bin/whisper-cli
WHISPERCPP_THREADS=2
WHISPERCPP_NO_GPU=1

CAPTURE_DURATION=12
SILENCE_RMS_THRESHOLD=220
SILENCE_ACTIVE_RATIO_THRESHOLD=0.015
CONTEXT_WINDOW_ITEMS=20
